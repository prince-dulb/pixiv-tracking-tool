# --- Pixiv 认证 ---
# 首次启动时会引导你通过浏览器 OAuth 授权，无需填写以下信息。
# 授权成功后 refresh_token 会存入 data/pixiv_token.json，下次自动登录。
#
# 如果你已有 refresh_token，直接填在这里
PIXIV_REFRESH_TOKEN=

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据存储目录（默认 . 即程序所在目录，内部结构：data/ + images/）
# DATA_ROOT=.

# 定时检查间隔（小时）
CHECK_INTERVAL_HOURS=6
# 定时检查间隔（分钟），设 0 表示不用分钟单位
CHECK_INTERVAL_MINUTES=0

# 下载并发数
DOWNLOAD_WORKERS=3
# API 请求间隔（秒）
REQUEST_DELAY=1.0
