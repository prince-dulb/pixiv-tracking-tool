PIXIV_USERNAME=your_pixiv_id_or_email
PIXIV_PASSWORD=your_pixiv_password
# 首次登录后会自动生成 data/pixiv_token.json，后续优先用 token 登录
# 如果已有 refresh_token 也可以直接填在这里
PIXIV_REFRESH_TOKEN=

# 服务配置
HOST=0.0.0.0
PORT=8000

# 定时检查间隔（小时）
CHECK_INTERVAL_HOURS=6
# 定时检查间隔（分钟），设 0 表示不用分钟单位
CHECK_INTERVAL_MINUTES=0

# 下载并发数
DOWNLOAD_WORKERS=3
# API 请求间隔（秒）
REQUEST_DELAY=1.0
