[MASTER]
# pylintrc — 只关注真问题，屏蔽风格噪声

[MESSAGES CONTROL]
disable=
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    C0301,  # line-too-long
    C0411,  # wrong-import-order
    C0415,  # import-outside-toplevel（本项目大量懒加载，有意为之）
    W0718,  # broad-exception-caught（本项目基础异常处理，有意为之）
    E0402,  # relative-beyond-top-level（pylint 不识别本项目包结构，误报）
    E0611,  # no-name-in-module（同上）
    W0212,  # protected-access（tracker 内部方法在 routes 中调用，设计如此）
    C0103,  # invalid-name（模块级 _private 变量命名，有意为之）
    R0903,  # too-few-public-methods

[FORMAT]
max-line-length=120
